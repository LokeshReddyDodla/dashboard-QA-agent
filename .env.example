# Copy this file to ".env" and fill in ONE provider's key, then pick a matching MODEL.

# --- Option A: OpenAI ---
OPENAI_API_KEY=sk-your-openai-key-here
MODEL=gpt-4o-mini

# --- Option B: Google Gemini (uncomment to use instead) ---
# GEMINI_API_KEY=your-gemini-key-here
# MODEL=gemini/gemini-1.5-pro

# Lower = more consistent, factual answers. 0.2 is a good default for a help bot.
TEMPERATURE=0.2
